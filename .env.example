GENAI_LAB_PROFILE=dev
GENAI_LAB_LLM_PROVIDER=ollama
GENAI_LAB_CHAT_MODEL=llama3.1
GENAI_LAB_EMBEDDING_MODEL=nomic-embed-text
GENAI_LAB_OLLAMA_BASE_URL=http://ollama:11434

GENAI_LAB_VECTOR_STORE_PROVIDER=pgvector
GENAI_LAB_POSTGRES_DSN=postgresql://genai_lab:genai_lab@postgres:5432/genai_lab
GENAI_LAB_POSTGRES_VECTOR_TABLE=research_chunks
GENAI_LAB_EMBEDDING_DIMENSION=768

GENAI_LAB_INGESTION_INPUT_DIR=data/research_notes
GENAI_LAB_INGESTION_CACHE_DIR=.cache/llamaindex/ingestion
GENAI_LAB_CHUNK_SIZE_TOKENS=512
GENAI_LAB_CHUNK_OVERLAP_TOKENS=80

GENAI_LAB_MCP_SERVER_URL=http://mcp-server:8080
GENAI_LAB_LANGSMITH_TRACING=false

# Production/profile-specific secrets belong in .env.prod.local or a secret manager.
# GENAI_LAB_OPENAI_API_KEY=
# GENAI_LAB_GOOGLE_API_KEY=
# GENAI_LAB_ANTHROPIC_API_KEY=
# GENAI_LAB_PINECONE_API_KEY=
# GENAI_LAB_LANGSMITH_API_KEY=
